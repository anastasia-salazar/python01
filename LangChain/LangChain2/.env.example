# Copy this file to .env and fill in the credentials from the company API guide.
# .env is ignored by git - never commit real credentials.
LLM_USERNAME=
LLM_PASSWORD=

# Optional overrides
# LLM_API_URL=https://aimodels.jadeglobal.com:8082
# LLM_MODEL=llama3.1:8b
# EMBEDDING_MODEL=nomic-embed-text

# To use Ollama installed on your own machine instead of the company server:
# LLM_API_URL=http://localhost:11434
# LLM_MODEL=llama3.2:3b
# (leave LLM_USERNAME / LLM_PASSWORD empty)

# Assignment 4: optional prices (US$ per 1M tokens) to estimate paid-API cost
# PROMPT_PRICE_PER_1M=0.15
# COMPLETION_PRICE_PER_1M=0.60
